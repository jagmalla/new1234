# Secrets — the real .env stays OUT of version control (lives outside webroot)
.env

# PHP
/vendor/
*.log

# Access-log runtime state (regenerated on the host; never committed)
/storage/.visits.json
/storage/.geo_cache.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Build artifacts (generated update bundles)
auto_business_update.zip
timezone_dst_fix.zip

# Local test router — regenerated by .claude/hooks/session-start.sh on every
# session and never part of a release. Ignored so it cannot be committed by
# accident (it emulates .htaccess for `php -S`, which the live host does not use).
/_devrouter.php
